# ─── HyperEVM contracts ──────────────────────────────────────────────────
#
# Public chain addresses, not secrets. Absent values make `isDeployed(chainId)`
# false for that chain, and every surface explains itself rather than offering a
# form that cannot work.
#
# Testnet (chain 998), deployed 4 November 2026.
NEXT_PUBLIC_HL_TESTNET_REGISTRY=0x6757474DDC00CDa23F497faC09A2CD4B27117aCe
NEXT_PUBLIC_HL_TESTNET_WHITELIST=0x1445B9E5080a9fB5dfdB97537935f8D4c40F3f4A
NEXT_PUBLIC_HL_TESTNET_FACTORY=0x7c5F82a727ff7823E1EabC49119A6d6e823779b8

# Mainnet (chain 999). Nothing is deployed; leave empty.
NEXT_PUBLIC_HL_MAINNET_REGISTRY=
NEXT_PUBLIC_HL_MAINNET_WHITELIST=
NEXT_PUBLIC_HL_MAINNET_FACTORY=
