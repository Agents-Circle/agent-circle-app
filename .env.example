NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Admin vetting (server only — never prefix with NEXT_PUBLIC_) ─────────
#
# Used only by app/api/admin/vetting. approve_agent / reject_agent are executable by
# service_role alone (migration 20261104000200), so this route is the only way to them.
# Leave any of these empty and /admin answers 503 instead of approving anything.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated EVM addresses (EOAs) allowed to sign vetting actions.
ADMIN_WALLETS=
# The code the existing RPC bodies check in p_code. Kept server-side; no longer typed
# into the browser. Remove once the RPCs drop the parameter.
ADMIN_VETTING_CODE=

# ─── HyperEVM contracts ──────────────────────────────────────────────────
#
# Public chain addresses, not secrets. Absent values make `isDeployed(chainId)`
# false for that chain, and every surface explains itself rather than offering a
# form that cannot work.
#
# Testnet (chain 998), deployed 4 November 2026.
NEXT_PUBLIC_HL_TESTNET_REGISTRY=0x6757474DDC00CDa23F497faC09A2CD4B27117aCe
NEXT_PUBLIC_HL_TESTNET_WHITELIST=0x1445B9E5080a9fB5dfdB97537935f8D4c40F3f4A
NEXT_PUBLIC_HL_TESTNET_FACTORY=0x7c5F82a727ff7823E1EabC49119A6d6e823779b8

# Mainnet (chain 999). Nothing is deployed; leave empty.
NEXT_PUBLIC_HL_MAINNET_REGISTRY=
NEXT_PUBLIC_HL_MAINNET_WHITELIST=
NEXT_PUBLIC_HL_MAINNET_FACTORY=
