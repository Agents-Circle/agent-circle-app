# Copy to services/.env and fill in. Never commit the filled copy.
#
# The keeper signs transactions. Its key belongs in this file or in the process
# environment of whatever runs it, and nowhere else — not in the repo, not in a config
# module, not in a container image.

# ───────────────────────────────── network
# testnet (998) or mainnet (999). Testnet is the default and the only network these
# services have been run against.
NETWORK=testnet
HYPEREVM_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
# Defaults to the Hyperliquid info API for the chosen network; override for a proxy.
# HYPERLIQUID_INFO_URL=https://api.hyperliquid-testnet.xyz/info

# ───────────────────────────────── contracts
# HyperEVM testnet (chain 998), deployed 4 November 2026. Verified with
# `make verify-deploy` in agent-circle-evm. Mainnet has no deployment, so a mainnet run
# needs these set by hand.
REGISTRY_ADDRESS=0x6757474DDC00CDa23F497faC09A2CD4B27117aCe
FACTORY_ADDRESS=0x7c5F82a727ff7823E1EabC49119A6d6e823779b8
# Optional. Only the keeper's fast-mode cap check needs it.
WHITELIST_ADDRESS=0x1445B9E5080a9fB5dfdB97537935f8D4c40F3f4A

# ───────────────────────────────── database
SUPABASE_URL=
# The service-role key, not the anon key. Every table these services write has RLS on
# with no write policy, so the anon key would silently write nothing.
SUPABASE_SERVICE_ROLE_KEY=

# ───────────────────────────────── indexer
# First block to scan. The registry's deploy block; 0 means genesis, which on a public
# chain is a very long wait.
INDEXER_START_BLOCK=0
INDEXER_POLL_MS=15000
# Blocks per getLogs call. Public RPCs cap this; 2000 is conservative.
INDEXER_BLOCK_RANGE=2000

# ───────────────────────────────── keeper
# Hex, 0x-prefixed. A hot key with HYPE for gas and no other authority: `reconcile` is
# permissionless, so this key cannot move a trader's funds even if it leaks.
KEEPER_PRIVATE_KEY=
KEEPER_POLL_MS=30000
# Reconcile every vault at least this often, even with nothing else to do: the execution
# fee only accrues when someone calls it.
KEEPER_MAX_RECONCILE_INTERVAL_MS=3600000
# Warn when drawdown gets within this many bps of a vault's limit.
KEEPER_DRAWDOWN_WARN_MARGIN_BPS=200
# Nothing is signed or sent unless this is exactly "true". Default is a dry run that
# logs the transaction it would have sent.
KEEPER_SEND=false
# Required, verbatim, before the keeper will sign on mainnet. See services/README.md.
# KEEPER_MAINNET_ACK=
LOG_LEVEL=info

# ───────────────────────────────── arena (npm run arena)
# Paper trading only: holds no key, signs nothing. Needs SUPABASE_URL and the
# service-role key above, and none of the contract or RPC variables.
# NETWORK selects the Hyperliquid market data; Season 0 trades mainnet prices.
# ARENA_SEASON_SLUG=season-0
# ARENA_COINS=BTC,ETH,SOL
# Input log. Back it up: it is the season. Its .season.json sits beside it.
# ARENA_LOG_PATH=./arena-data/season-0.jsonl
# ARENA_PORT=8787
# ARENA_PUBLISH_MS=60000
