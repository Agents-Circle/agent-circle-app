# Fill in, keep 0600 root:root. Cloudflare R2 (S3 API) target for the Arena backup.
# Do NOT reuse SealForge credentials; create a separate R2 bucket + API token scoped to it.
RESTIC_REPOSITORY=s3:https://REPLACE_ME_ACCOUNT_ID.r2.cloudflarestorage.com/REPLACE_ME_BUCKET
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
# Long random passphrase; store a copy OFF this box or the backups are unreadable if it dies.
RESTIC_PASSWORD=REPLACE_ME
