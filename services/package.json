{
  "name": "agent-circle-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indexer and keeper for the HyperEVM vaults.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "indexer": "node --disable-warning=ExperimentalWarning src/indexer/main.ts",
    "keeper": "node --disable-warning=ExperimentalWarning src/keeper/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "viem": "^2.37.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
