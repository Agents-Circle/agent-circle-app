{
  "name": "agent-circle-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indexer, keeper and the Arena paper-trading engine.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "indexer": "node --disable-warning=ExperimentalWarning src/indexer/main.ts",
    "keeper": "node --disable-warning=ExperimentalWarning src/keeper/main.ts",
    "arena": "node --disable-warning=ExperimentalWarning src/arena/main.ts",
    "arena:replay": "node --disable-warning=ExperimentalWarning src/arena/replay.ts",
    "arena:record": "node --disable-warning=ExperimentalWarning src/arena/record.ts",
    "arena:check-recording": "node --disable-warning=ExperimentalWarning src/arena/check-recording.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'",
    "elysium:pools": "node --disable-warning=ExperimentalWarning src/elysium/pools.ts",
    "arena:admin": "node --disable-warning=ExperimentalWarning src/arena/admin-cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "viem": "^2.37.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
