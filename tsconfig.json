{
  "compilerOptions": {
    // ES2020 for `bigint` literals. viem and wagmi represent every on-chain integer as a
    // bigint — a uint256 does not fit a JS number and silently losing precision on a
    // balance is not an option — so the app cannot avoid them. ES2017 was Next's old
    // default and predates `BigInt`; every browser the app supports has had it for years.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `services/` has its own tsconfig and is compiled by nobody: Node runs those files
  // directly with type stripping, so their relative imports carry a real `.ts` extension
  // that this config rejects. Two processes, two compilers, two configs.
  "exclude": ["node_modules", "services"]
}
